<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bifrost_bg" android:padding="16dp">
    <ScrollView android:id="@+id/guideScroll"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="16dp">
            <ImageView android:layout_width="56dp" android:layout_height="56dp"
                android:layout_marginBottom="16dp" android:src="@mipmap/ic_launcher"
                android:importantForAccessibility="no" />
            <TextView android:id="@+id/guideTitle" style="@style/GuiHeading"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/gui_setup_title" android:textSize="28sp"
                android:accessibilityHeading="true" />
            <TextView android:id="@+id/guideProgressText" style="@style/GuiSecondary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite" />
            <LinearLayout android:id="@+id/guidePageContainer"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />
            <com.google.android.material.button.MaterialButton android:id="@+id/guideNext"
                style="@style/GuiPrimaryButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="24dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/guideBack"
                style="@style/GuiButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/onboarding_back" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
