<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/bifrost_card"
    android:layout_margin="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@color/bifrost_card">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gui_dialog_app_profiles"
            android:textColor="@color/bifrost_text"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"
            android:accessibilityHeading="true"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:id="@+id/mappingsSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gui_dialog_app_profiles_description"
            android:textColor="@color/bifrost_text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"
            android:lineSpacingExtra="3dp" />

        <ListView
            android:id="@+id/mappingsListView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/gui_dialog_list_height"
            android:divider="@android:color/transparent"
            android:dividerHeight="4dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
