<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activePresetInfoCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/bifrost_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/bifrost_accent"
    app:strokeWidth="1dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_glow_bg"
        android:orientation="vertical"
        android:padding="@dimen/bifrost_card_padding">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/activePresetNameText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Default"
                android:textColor="@color/bifrost_text"
                android:textSize="@dimen/bifrost_active_preset_title_size"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/activePresetStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_active_bg"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="ACTIVE"
                android:textColor="@color/bifrost_text"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:visibility="gone" />
        </LinearLayout>
        <TextView
            android:id="@+id/activePresetAnimationText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Animation: Static"
            android:textColor="@color/bifrost_text_secondary"
            android:textSize="@dimen/bifrost_active_preset_meta_size"
            android:letterSpacing="0.04" />
        <TextView
            android:id="@+id/activePresetProfileText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Profile: High"
            android:textColor="@color/bifrost_text_secondary"
            android:textSize="@dimen/bifrost_active_preset_meta_size"
            android:letterSpacing="0.04" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
