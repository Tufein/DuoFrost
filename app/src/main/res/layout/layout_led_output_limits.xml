<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/led_output_maximum_label"
        android:textColor="@color/bifrost_text"
        android:textSize="12sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/led_output_maximum_description"
        android:textColor="@color/bifrost_text_secondary"
        android:textSize="11sp" />
    <TextView
        android:id="@+id/maximumOutputValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/bifrost_text"
        android:textSize="12sp" />
    <SeekBar
        android:id="@+id/maximumOutputSeekBar"
        style="@style/DuoFrostSeekBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:contentDescription="@string/led_output_maximum_label" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/led_output_battery_label"
        android:textColor="@color/bifrost_text"
        android:textSize="12sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/batterySaverLimitValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/bifrost_text"
        android:textSize="12sp" />
    <SeekBar
        android:id="@+id/batterySaverLimitSeekBar"
        style="@style/DuoFrostSeekBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:contentDescription="@string/led_output_battery_label" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/screenOffDimmingSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/led_output_screen_off_label"
        android:textColor="@color/bifrost_text"
        android:textSize="12sp"
        android:textStyle="bold"
        app:thumbTint="@color/switch_thumb_tint"
        app:trackTint="@color/switch_track_tint" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/led_output_screen_off_description"
        android:textColor="@color/bifrost_text_secondary"
        android:textSize="11sp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/led_output_screen_off_limit_label"
        android:textColor="@color/bifrost_text_secondary"
        android:textSize="11sp" />
    <TextView
        android:id="@+id/screenOffLimitValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/bifrost_text"
        android:textSize="12sp" />
    <SeekBar
        android:id="@+id/screenOffLimitSeekBar"
        style="@style/DuoFrostSeekBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:contentDescription="@string/led_output_screen_off_limit_label" />
</LinearLayout>
