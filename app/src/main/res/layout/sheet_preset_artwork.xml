<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bifrost_card"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="42dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            app:cardBackgroundColor="@color/bifrost_text_secondary"
            app:cardCornerRadius="999dp"
            app:cardElevation="0dp" />

        <TextView
            android:id="@+id/presetArtworkTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/gui_preset_artwork_title"
            android:textColor="@color/bifrost_text"
            android:textSize="22sp"
            android:textStyle="bold"
            android:accessibilityHeading="true"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:id="@+id/presetArtworkSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/gui_preset_artwork_description"
            android:textColor="@color/bifrost_text_secondary"
            android:textSize="14sp"
            android:visibility="gone"
            android:lineSpacingExtra="3dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/bifrost_surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/bifrost_surface"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bifrost_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/color_preview_bg"
                    android:foregroundGravity="center">

                    <ImageView
                        android:id="@+id/presetArtworkPreviewImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/gui_preset_preview" />

                    <TextView
                        android:id="@+id/presetArtworkPreviewEmoji"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@color/bifrost_text"
                        android:textSize="42sp"
                        android:visibility="gone"
                        android:lineSpacingExtra="3dp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/presetArtworkPreviewName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/bifrost_text"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/presetArtworkPreviewLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/bifrost_text_secondary"
                        android:textSize="14sp"
                        android:visibility="gone"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/presetArtworkUploadButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/bifrost_surface"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/gui_upload_image"
                android:textColor="@color/bifrost_text"
                android:textSize="14sp"
                app:cornerRadius="12dp"
                app:strokeColor="@color/bifrost_surface"
                app:strokeWidth="1dp"
                android:textAllCaps="false"
                android:minHeight="48dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/presetArtworkResetButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/bifrost_surface"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/gui_use_saved_icon"
                android:textColor="@color/bifrost_text"
                android:textSize="14sp"
                android:visibility="gone"
                app:cornerRadius="12dp"
                app:strokeColor="@color/bifrost_surface"
                app:strokeWidth="1dp"
                android:textAllCaps="false"
                android:minHeight="48dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Built-in icons"
            android:textColor="@color/bifrost_text_secondary"
            android:textSize="14sp"
            android:visibility="gone"
            android:lineSpacingExtra="3dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/presetArtworkIconOptions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Custom emoji"
            android:textColor="@color/bifrost_text_secondary"
            android:textSize="14sp"
            android:visibility="gone"
            android:lineSpacingExtra="3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/presetArtworkEmojiInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Emoji or symbol"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/bifrost_accent"
                app:hintTextColor="@color/bifrost_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/presetArtworkEmojiInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/bifrost_text"
                    android:textColorHint="@color/bifrost_text_secondary"
                    android:textSize="16sp"
                    android:minHeight="48dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/presetArtworkApplyEmojiButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:backgroundTint="@color/bifrost_surface"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/gui_apply"
                android:textColor="@color/bifrost_text"
                android:textSize="14sp"
                app:cornerRadius="12dp"
                app:strokeColor="@color/bifrost_surface"
                app:strokeWidth="1dp"
                android:textAllCaps="false"
                android:minHeight="48dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/presetArtworkCloseButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/bifrost_surface"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/gui_done"
            android:textColor="@color/bifrost_text"
            android:textSize="14sp"
            app:cornerRadius="12dp"
            app:strokeColor="@color/bifrost_surface"
            app:strokeWidth="1dp"
            android:textAllCaps="false"
            android:minHeight="48dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
