<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.DuoFrost" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.DuoFrost.Dialog</item>
        <item name="colorPrimary">@color/bifrost_accent</item>
        <item name="colorOnPrimary">@color/bifrost_icon</item>
        <item name="colorSecondary">@color/bifrost_accent_light</item>
        <item name="colorSurface">@color/bifrost_card</item>
        <item name="colorOnSurface">@color/bifrost_text</item>
        <item name="colorOnSurfaceVariant">@color/bifrost_text_secondary</item>
        <item name="colorOutline">@color/bifrost_outline</item>
        <item name="android:windowBackground">@color/bifrost_bg</item>
        <item name="android:colorBackground">@color/bifrost_bg</item>
        <item name="android:navigationBarColor">@color/bifrost_bg</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.DuoFrost" parent="Base.Theme.DuoFrost" />

    <style name="DuoFrostSeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressDrawable">@drawable/seekbar_progress</item>
        <item name="android:thumb">@drawable/seekbar_thumb</item>
        <item name="android:maxHeight">4dp</item>
        <item name="android:minHeight">4dp</item>
        <item name="android:thumbOffset">0dp</item>
    </style>

    <style name="DuoFrostSeekBarRGB" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressDrawable">@drawable/seekbar_progress_rgb</item>
        <item name="android:thumb">@drawable/seekbar_thumb_rgb</item>
        <item name="android:maxHeight">6dp</item>
        <item name="android:minHeight">6dp</item>
        <item name="android:thumbOffset">0dp</item>
    </style>

</resources>